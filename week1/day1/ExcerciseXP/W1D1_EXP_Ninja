# Excersise 5: Longest word without a specific character
longest = 0
while True:
    sentence = input("Enter the longest sentence you can without the letter 'A': ")

    if "A" in sentence:
        print("You used the letter 'A'. Try again.")
        continue

    if len(sentence) > longest:
        longest = len(sentence)
        print(f"Congratulations! New longest sentence: {longest} characters.")
